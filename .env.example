# Nexlayer Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME=nexlayer
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://nexlayer:nexlayer_secret@localhost:5432/nexlayer

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Keys (comma-separated list of valid API keys)
API_KEYS=

# AI Provider Credentials (stored securely, never in source)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_ENDPOINT=http://localhost:11434

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=nexlayer

# Policy Configuration
POLICY_CONFIG_PATH=config/policies.yaml
